# The cella inner environment's fragment: a KVM host, so the guest can boot
# a guest. The same stack cella's nested kernel carries
# (kernel-fragment-nested.config there; docs/NESTED-BOOT.md proves it under
# the cella VMM), copied, not referenced. Merged on top of
# kernel-fragment-base.config (see there).
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
# The inner machine's rootless network makes its own interface.
CONFIG_TUN=y
