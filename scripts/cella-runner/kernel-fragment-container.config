# The container-capable guest kernel for `cella-runner` (docs/runners/CELLA-RUNNER.md).
#
# Self-contained: merged onto x86_64_defconfig by `make .cella-runner-kernel`,
# and nothing else. It depends on no other repo -- not on cella's fragments,
# source cache, or build outputs. It carries both halves itself:
#
#   1. what a cella micro-VM needs to boot at all (virtio-mmio on the kernel
#      command line, an 8250 serial console, an ext4 root, devtmpfs, the KVM
#      guest clock) -- because the guest is booted by the cella VMM;
#   2. what docker/runc need to run a container -- which cella's own minimal
#      guest kernel deliberately omits.
#
# cella only consumes the resulting bzImage (it checks the file exists at
# create; it never builds or re-hashes it), so this makes no cella change.

# --- half 1: boot under the cella VMM ------------------------------------
# virtio over MMIO, discovered from the kernel command line (no ACPI/PCI in
# the microVM). These must be builtin (=y): there is no initrd to load modules.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
# The one channel out of the guest: the 8250 UART as the console.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# The root filesystem and its automatic /dev.
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# Static ip= configuration parsed in-kernel; the KVM paravirt clock.
CONFIG_IP_PNP=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_HYPERVISOR_GUEST=y

# --- half 2: the device cgroup (the hard blocker) ------------------------
# runc's cgroup-v2 device controller installs a BPF_CGROUP_DEVICE program.
# Without CONFIG_CGROUP_BPF the container cannot start:
#   bpf_prog_query(BPF_CGROUP_DEVICE) failed: function not implemented
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# --- the rest of the cgroup v2 controllers -------------------------------
# So the inner container can carry cpu/memory/pid/io limits honestly.
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y

# --- the container root filesystem ---------------------------------------
# Overlay lets docker use a layered store instead of vfs's full per-layer copy.
CONFIG_OVERLAY_FS=y

# --- namespaces docker requires ------------------------------------------
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_USER_NS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y

# --- container networking (the bridge and the NAT membrane path) ---------
# Not needed for an airgapped inner run (bridge=none), but a container kernel
# that cannot network is only half a kernel, and the judged-network path needs
# the bridge, veth, and netfilter/NAT stack.
CONFIG_BRIDGE=y
CONFIG_VETH=y
CONFIG_DUMMY=y
CONFIG_VXLAN=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
# Debian's docker.io drives iptables-nft, so the nft families and the
# expressions docker's rules compile to must be builtin, not just the
# framework: without NF_TABLES_IPV4 the daemon dies at
# "iptables -t nat -N DOCKER: TABLE_ADD failed (Operation not supported)".
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_CT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
# The NAT target itself. IP_NF_TARGET_MASQUERADE is only a selector; olddefconfig
# leaves the real symbol tristate (=m), and this guest loads no modules.
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
# DNAT/SNAT (xt_nat): docker's embedded DNS is a DNAT of 127.0.0.11:53 inside
# every container netns; without it service names (the egress sidecar) do not
# resolve. REDIRECT and multiport are the rest of docker's rule vocabulary.
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_BRIDGE_NETFILTER=y
