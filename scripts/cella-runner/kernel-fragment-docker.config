# The docker inner environment's fragment: what docker/runc need to run a
# container, which cella's own minimal guest kernel deliberately omits.
# Merged on top of kernel-fragment-base.config (see there).

# --- the device cgroup (the hard blocker) ---------------------------------
# runc's cgroup-v2 device controller installs a BPF_CGROUP_DEVICE program.
# Without CONFIG_CGROUP_BPF the container cannot start:
#   bpf_prog_query(BPF_CGROUP_DEVICE) failed: function not implemented
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# --- the rest of the cgroup v2 controllers -------------------------------
# So the inner container can carry cpu/memory/pid/io limits honestly.
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y

# --- the container root filesystem ---------------------------------------
# Overlay lets docker use a layered store instead of vfs's full per-layer copy.
CONFIG_OVERLAY_FS=y

# The rest of what docker asks of the kernel beyond the base namespaces.
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y

# --- container networking (the bridge and the NAT membrane path) ---------
# Not needed for an airgapped inner run (bridge=none), but a container kernel
# that cannot network is only half a kernel, and the judged-network path needs
# the bridge, veth, and netfilter/NAT stack.
CONFIG_BRIDGE=y
CONFIG_VETH=y
CONFIG_DUMMY=y
CONFIG_VXLAN=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
# Debian's docker.io drives iptables-nft, so the nft families and the
# expressions docker's rules compile to must be builtin, not just the
# framework: without NF_TABLES_IPV4 the daemon dies at
# "iptables -t nat -N DOCKER: TABLE_ADD failed (Operation not supported)".
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_CT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
# The NAT target itself. IP_NF_TARGET_MASQUERADE is only a selector; olddefconfig
# leaves the real symbol tristate (=m), and this guest loads no modules.
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
# DNAT/SNAT (xt_nat): docker's embedded DNS is a DNAT of 127.0.0.11:53 inside
# every container netns; without it service names (the egress sidecar) do not
# resolve. REDIRECT and multiport are the rest of docker's rule vocabulary.
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_BRIDGE_NETFILTER=y
