# The base of every cella-runner guest kernel (docs/runners/CELLA-RUNNER.md §4).
#
# Merged onto x86_64_defconfig by `make .cella-runner-kernel-<inner-env>`
# together with that environment's own fragment, and nothing else. Each
# inner environment boots a kernel that carries only what it needs: the
# guest kernel is the boundary an escape lands on, so its surface is per
# environment, not the union. This file depends on no other repo -- not on
# cella's fragments, source cache, or build outputs. cella only consumes the
# resulting bzImage (it checks the file exists at create; it never builds or
# re-hashes it).
#
# What a cella micro-VM needs to boot at all, because the guest is booted by
# the cella VMM: virtio over MMIO, discovered from the kernel command line
# (no ACPI/PCI in the microVM). These must be builtin (=y): there is no
# initrd to load modules.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
# The one channel out of the guest: the 8250 UART as the console.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# The root filesystem and its automatic /dev.
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# Static ip= configuration parsed in-kernel; the KVM paravirt clock.
CONFIG_IP_PNP=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_HYPERVISOR_GUEST=y
# The namespaces both inner environments unshare: docker for its containers,
# cella's bwrap jail for its VMM (user, pid, ipc, uts, cgroup).
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
