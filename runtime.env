# runtime.env — pinned runtime dependencies. Checked in: this file is the
# single source of truth for the versions host provisioning installs and
# preflight demands, so two hosts provisioned from the same commit land on
# the same runtime. Not secrets — those live in .secrets (gitignored).
#
# Consumers (each refuses to run without this file rather than guess):
#   scripts/init/runsc-podman.sh   installs + digest-pins runsc for podman
#   scripts/init/runsc.sh          installs runsc + shim for docker
#   scripts/doctor/podman.sh       preflight minimum-version checks
#
# Shell-sourceable; the ${VAR:-...} idiom keeps one-off overrides possible
# from the environment, e.g.: RUNSC_VERSION=20260901.0 bash scripts/init/runsc-podman.sh

# gVisor release both engines install and digest-pin. Upgrade deliberately:
# bump here, then per host replace the binary, delete the digest pin, re-run
# init (see scripts/init/runsc-podman.sh).
RUNSC_VERSION=${RUNSC_VERSION:-20260810.0}

# Minimum podman-compose: 1.6.0 introduced `depends_on: condition:
# service_healthy`, which the egress-proxy compose files rely on.
PODMAN_COMPOSE_MIN_VERSION=${PODMAN_COMPOSE_MIN_VERSION:-1.6.0}
