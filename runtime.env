# runtime.env — pinned runtime dependencies. Checked in: this file is the
# single source of truth for the versions host provisioning installs and
# preflight demands, so two hosts provisioned from the same commit land on
# the same runtime. Not secrets — those live in .secrets (gitignored).
#
# Consumers (each refuses to run without this file rather than guess):
#   scripts/init/runsc-podman.sh   installs + digest-pins runsc for podman
#   scripts/init/runsc.sh          installs runsc + shim for docker
#   scripts/init/krun-podman.sh    installs + digest-pins krun for podman
#   scripts/init/cella.sh          installs + digest-pins cella from a git rev
#   scripts/doctor/podman.sh       preflight minimum-version checks
#
# Shell-sourceable; the ${VAR:-...} idiom keeps one-off overrides possible
# from the environment, e.g.: RUNSC_VERSION=20260901.0 bash scripts/init/runsc-podman.sh

# gVisor release both engines install and digest-pin. Upgrade deliberately:
# bump here, then per host replace the binary, delete the digest pin, re-run
# init (see scripts/init/runsc-podman.sh).
RUNSC_VERSION=${RUNSC_VERSION:-20260810.0}

# Minimum podman-compose: 1.6.0 introduced `depends_on: condition:
# service_healthy`, which the egress-proxy compose files rely on.
PODMAN_COMPOSE_MIN_VERSION=${PODMAN_COMPOSE_MIN_VERSION:-1.6.0}

# Minimum krun version. krun comes from the distro crun-krun package: crun
# built with the libkrun handler, which runs each container in a KVM microVM.
# This is a floor, not an exact pin like RUNSC_VERSION: upstream supplies no
# standalone checksummed binary, so dnf is the supply chain and init can only
# demand a minimum. The digest pin that scripts/init/krun-podman.sh writes
# makes the installed binary tamper-evident.
CRUN_KRUN_MIN_VERSION=${CRUN_KRUN_MIN_VERSION:-1.28}

# Cella: the sealed-VM rung's runtime. No package, no release artifact yet,
# so the supply chain is a git clone at an exact rev — a pin, not a floor:
# the integration's claim is "works against unchanged cella", and the rev
# names the cella it was proven against. Upgrade deliberately: bump the rev,
# delete the digest pin, re-run scripts/init/cella.sh. The URL is https on
# purpose — provisioning must not depend on the operator's ssh keys.
CELLA_GIT_URL=${CELLA_GIT_URL:-https://github.com/omne-earth/cella.git}
CELLA_GIT_REV=${CELLA_GIT_REV:-7758fc737dda404c5e9f750fb94911ddc1b7067e}
