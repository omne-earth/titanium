# cella.policy — the crossings this task is granted.
# One grant per line: allow <direction> <ip>:<port>/<proto>
#                  or allow <direction> <ethertype>
# '*' matches any ip or any port. Everything not granted is refused.
#
# Every grant is exact, and every flow is a round trip at this border:
# the request parks outgoing and the reply parks in the ingress lane,
# so a granted destination needs its reply twin. Same for ARP: the
# guest asks, the translator answers. Everything else is refused, with
# the why on the machine's record.
allow outgoing arp
allow incoming arp
allow outgoing 1.1.1.1:443/tcp
allow incoming 1.1.1.1:443/tcp
